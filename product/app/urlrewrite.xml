<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE urlrewrite PUBLIC "-//tuckey.org//DTD UrlRewrite 4.0//EN"
        "http://www.tuckey.org/res/dtds/urlrewrite4.0.dtd">
<urlrewrite>
    <rule>
        <name>SPA routes</name>
        <condition type="request-uri" operator="notequal">^/(api/|www/|spa\.cfm)</condition>
        <from>^/(?!api/|www/).*$</from>
        <to type="passthrough">/index.cfm</to>
    </rule>
</urlrewrite>
